<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

	<modelVersion>4.0.0</modelVersion>

	<!-- =========================================================
         SPRING BOOT
         ========================================================= -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.3.3</version>
		<relativePath/>
	</parent>

	<!-- =========================================================
         PROJECT INFORMATION
         ========================================================= -->
	<groupId>com.shehia_management</groupId>
	<artifactId>api</artifactId>
	<version>0.0.1-SNAPSHOT</version>

	<name>shehia-api</name>
	<description>Shehia Management System API</description>

	<!-- =========================================================
         JAVA
         ========================================================= -->
	<properties>
		<java.version>21</java.version>
	</properties>

	<!-- =========================================================
         DEPENDENCIES
         ========================================================= -->
	<dependencies>

		<!-- =====================================================
              SPRING WEB / REST API
              ===================================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- =====================================================
              SPRING DATA JPA
              ===================================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- =====================================================
              VALIDATION
              ===================================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- =====================================================
              JACKSON DATABIND

              Required for:
              ObjectMapper
              TypeReference
              JSON serialization/deserialization
              ===================================================== -->
		<dependency>
			<groupId>com.fasterxml.jackson.core</groupId>
			<artifactId>jackson-databind</artifactId>
		</dependency>

		<!-- =====================================================
              THYMELEAF
              ===================================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>

		<!-- =====================================================
              SPRING SECURITY
              ===================================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- =====================================================
              MYSQL
              ===================================================== -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- =====================================================
              LOMBOK
              ===================================================== -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!-- =====================================================
              HTML -> PDF
              OpenHTMLToPDF
              ===================================================== -->
		<dependency>
			<groupId>com.openhtmltopdf</groupId>
			<artifactId>openhtmltopdf-pdfbox</artifactId>
			<version>1.0.10</version>
		</dependency>
		<!-- Tolerant HTML parser used ahead of openhtmltopdf. openhtmltopdf's
		     own withHtmlContent(...) parses via a strict XML parser that
		     requires every tag to be explicitly closed (e.g. <meta ... />),
		     which real-world/browser-serialized HTML (from the letter-edit
		     feature) does not guarantee - browsers always serialize void
		     elements like <meta>, <br>, <img> without the self-closing
		     slash. jsoup parses that tolerantly and we hand openhtmltopdf
		     a DOM tree instead of a raw string, sidestepping the strict
		     XML well-formedness requirement entirely. -->
		<dependency>
			<groupId>org.jsoup</groupId>
			<artifactId>jsoup</artifactId>
			<version>1.17.2</version>
		</dependency>

		<!-- =====================================================
              JWT - API
              ===================================================== -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>

		<!-- =====================================================
              JWT - IMPLEMENTATION
              ===================================================== -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<!-- =====================================================
              JWT - JACKSON
              ===================================================== -->
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<!-- =====================================================
              TESTING
              ===================================================== -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>

	</dependencies>

	<!-- =========================================================
         BUILD
         ========================================================= -->
	<build>
		<plugins>

			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>

				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>

			</plugin>

		</plugins>
	</build>

</project>